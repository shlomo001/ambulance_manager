# Database Configuration
POSTGRES_DB=ambulance_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_123
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://postgres:secure_password_123@localhost:5432/ambulance_manager

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_minimum_32_characters_long

# Redis Configuration
REDIS_PASSWORD=redis_password_123
REDIS_URL=redis://localhost:6379

# Google Sheets Integration (אופציונלי - ניתן להגדיר אחר כך)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS=

# Application Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
