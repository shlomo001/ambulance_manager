              "raw": "{\n  \"email\": \"driver@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"משה\",\n  \"lastName\": \"לוי\",\n  \"role\": \"DRIVER\",\n  \"isActive\": true\n}"
            },
            "url": {
